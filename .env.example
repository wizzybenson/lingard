# Copy to .env. Never commit .env.
ENV=local
DATABASE_URL=postgresql+psycopg://lingard:lingard@localhost:55432/lingard
REDIS_URL=redis://localhost:56379/0
JWT_SECRET=change-me-to-64-random-characters
ANTHROPIC_API_KEY=
# STT / TTS providers (live plane)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
VOICEBOX_URL=http://localhost:17493
DEEPGRAM_API_KEY=
# LiveKit (self-hosted; dev keys match `livekit-server --dev`)
LIVEKIT_URL=ws://localhost:57880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Observability (optional)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
