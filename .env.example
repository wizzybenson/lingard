# Lingard environment. Copy to .env and fill in what you have. Never commit .env.
# Providers are picked by what is set: each group uses the first configured provider in its preference order
# and falls back to the next configured one. One key per group is enough.

# ── Core ───────────────────────────────────────────────────────────────────────────────────────────────────────
ENV=local
DATABASE_URL=postgresql+psycopg://lingard:lingard@localhost:55432/lingard
REDIS_URL=redis://localhost:56379/0
JWT_SECRET=change-me-to-64-random-characters

# ── Language models (scenes, assessment, coaching) ─────────────────────────────────────────────────────────────
# Any one. Order per tier in config/llm.yaml: Anthropic → OpenAI → Google.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Speech-to-text (what the learner says) ─────────────────────────────────────────────────────────────────────
# Any one. Order: Voicebox (self-hosted) → Deepgram → OpenAI → ElevenLabs. OPENAI_API_KEY and ELEVENLABS_API_KEY
# above/below are reused here; DEEPGRAM_API_KEY is speech-to-text only.
DEEPGRAM_API_KEY=

# ── Text-to-speech (NPC voices, listening items) ──────────────────────────────────────────────────────────────
# Any one. Order: Voicebox → ElevenLabs → OpenAI.
ELEVENLABS_API_KEY=
VOICEBOX_URL=

# ── Voice clone and golden self (Accent Studio) ───────────────────────────────────────────────────────────────
# The learner's voice clone uses Voicebox or ElevenLabs. The golden self (native line in the learner's own voice)
# needs ELEVENLABS_API_KEY in the pronunciation service's environment.
PRONUNCIATION_URL=http://localhost:58100
LINGARD_PRON_RECOGNIZER=auto

# ── LiveKit (self-hosted; dev keys match `livekit-server --dev`) ───────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:57880
LIVEKIT_PUBLIC_URL=ws://localhost:57880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Object storage (empty = in-memory, dev only; SeaweedFS S3 in compose is http://localhost:59000) ──────────
OBJECT_STORE_URL=
OBJECT_STORE_KEY=lingard
OBJECT_STORE_SECRET=lingard-local-only

# ── Observability (optional) ──────────────────────────────────────────────────────────────────────────────────
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
