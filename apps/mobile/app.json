{
  "expo": {
    "name": "Lingard",
    "slug": "lingard",
    "scheme": "lingard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f2a44"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lingard",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lingard listens when you talk to people in the city, so they can answer you.",
        "NSFaceIDUsageDescription": "Unlock Lingard without typing your PIN.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.lingard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f2a44"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Lingard listens when you talk to people in the city, so they can answer you."
        }
      ],
      "expo-localization",
      "@livekit/react-native-expo-plugin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Lingard without typing your PIN."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:58000"
    }
  }
}
