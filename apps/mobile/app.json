{
  "expo": {
    "name": "Lingard",
    "slug": "lingard",
    "scheme": "lingard",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lingard",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lingard listens when you talk to people in the city, so they can answer you.",
        "NSFaceIDUsageDescription": "Unlock Lingard without typing your PIN.",
        "NSCameraUsageDescription": "Lingard never turns on your camera. Its voice calls use a calling library that can also do video.",
        "NSLocalNetworkUsageDescription": "Lingard connects to your local Lingard server while you are developing.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.lingard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1f2a44"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "./plugins/withoutRemotePush",
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Lingard listens when you talk to people in the city, so they can answer you."
        }
      ],
      "expo-localization",
      "@livekit/react-native-expo-plugin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Lingard without typing your PIN."
        }
      ],
      "expo-sharing",
      "expo-notifications",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1f2a44"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:58000"
    },
    "backgroundColor": "#fbf8f2"
  }
}
